# Secret key for signing cookies
AUTH_SECRET=your-secret-key-change-in-production

# Postgres database connection
ZERO_UPSTREAM_DB=postgresql://postgres:postgres@localhost:5432/postgres

# Zero query/mutation endpoints
ZERO_QUERY_FORWARD_COOKIES=true
ZERO_QUERY_URL=http://localhost:5173/api/get-queries
ZERO_MUTATE_FORWARD_COOKIES=true
ZERO_MUTATE_URL=http://localhost:5173/api/mutate

# Zero API endpoint for the client
VITE_PUBLIC_ZERO_CACHE_URL="http://localhost:4848"
